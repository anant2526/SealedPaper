# ---------- SealedPaper API settings ----------
# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (local docker-compose default below; Neon/Supabase give you a URL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sealedpaper
# Set to true for hosted databases (Neon, Supabase, Render) that require SSL
DATABASE_SSL=false

# Generate both with: npm run keygen
MASTER_KEY=
JWT_SECRET=

PORT=4000
APP_NAME=SealedPaper
MAX_UPLOAD_MB=4

# Face verification: "real" runs the face models (use this). "mock" is only for automated tests.
FACE_MODE=real
# Tuning (defaults shown). Lower FACE_MATCH_THRESHOLD = stricter.
FACE_MATCH_THRESHOLD=0.5
FACE_CONSISTENCY_THRESHOLD=0.6
FACE_STRAIGHT_MAX_YAW=0.15
FACE_TURN_MIN_YAW=0.2
FACE_MIN_WIDTH_PX=80

# Failed key uploads allowed per custodian per document in 10 minutes
KEY_MAX_FAILURES=5
# Run the release worker inside the API process
RUN_WORKER=true
# Proxies between the browser and this API: 1 locally (Next.js), 2 for Vercel -> Render
TRUST_PROXY=1
# Set to production when deployed (forces secure cookies, forbids FACE_MODE=mock)
NODE_ENV=development
